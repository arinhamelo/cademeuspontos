{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cademeuspontos",
  "main": "worker.js",
  "compatibility_date": "2025-11-06",
  "observability": { "enabled": true },
  // Aviso diário por e-mail das compras com prazo vencido (12h UTC = 9h em Brasília)
  "triggers": { "crons": ["0 12 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cademeuspontos-db",
      "database_id": "b6cfe007-8ed8-4045-894e-21881646e26d"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["acesso@auth.arinhamelo.com.br"]
    }
  ]
}
